<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VirtualBattery</RootNamespace>
    <AssemblyName>VirtualBatterySetup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Virtual Battery</Product>
    <AssemblyTitle>Virtual Battery Setup</AssemblyTitle>
    <Company>azorkai</Company>
    <Copyright>MIT License</Copyright>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateSupportedRuntime>true</GenerateSupportedRuntime>
    <PathMap>$(MSBuildProjectDirectory)=/app</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <EmbeddedResource Include="..\out\driver\VirtualBattery.dll" LogicalName="VirtualBattery.dll" />
    <EmbeddedResource Include="..\out\driver\VirtualBattery.inf" LogicalName="VirtualBattery.inf" />
    <EmbeddedResource Include="..\out\driver\VirtualBattery.cat" LogicalName="VirtualBattery.cat" />
  </ItemGroup>
</Project>
